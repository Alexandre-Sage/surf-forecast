  Recommended Approach

  Option 3 is best:
  • Creates 12 table instances once per forecast table
  • Updates only data when day changes
  • Avoids recreating 288 instances

  Create table instances once and reuse them:

     1 │// Create a store/context for table instances
     2 │import { createContext, useContext, useMemo, useRef } from 'react';
     3 │
     4 │interface TableStore {
     5 │  getTableInstance: (cols: WaveForecastColumns, data: WavesSourceValues & { type: ForecastKey }) => ReturnType<typeof useReactTable>;
     6 │}
     7 │
     8 │const TableStoreContext = createContext<TableStore | null>(null);
     9 │
    10 │// Provider component
    11 │export const TableStoreProvider = ({ children }: { children: React.ReactNode }) => {
    12 │  const tableInstancesRef = useRef(new Map<string, ReturnType<typeof useReactTable>>());
    13 │  
    14 │  const getTableInstance = (cols: WaveForecastColumns, data: WavesSourceValues & { type: ForecastKey }) => {
    15 │    const key = `${data.type}`; // Key by type only (not data)
    16 │    
    17 │    if (!tableInstancesRef.current.has(key)) {
    18 │      const table = useReactTable({
    19 │        columns: cols,
    20 │        data: [data],
    21 │        getCoreRowModel: getCoreRowModel(),
    22 │        columnResizeMode: "onEnd",
    23 │      });
    24 │      tableInstancesRef.current.set(key, table);
    25 │    }
    26 │    
    27 │    const table = tableInstancesRef.current.get(key)!;
    28 │    // Update data in existing table
    29 │    table.setOptions(prev => ({
    30 │      ...prev,
    31 │      data: [data],
    32 │    }));
    33 │    
    34 │    return table;
    35 │  };
    36 │  
    37 │  return (
