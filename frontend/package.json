    "@tanstack/react-router": "^1.141.1",
    "@tanstack/react-router-devtools": "^1.141.1",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@eslint/js": "^9.39.1",
